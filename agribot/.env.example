# ─────────────────────────────────────────────────────────────────────────────
# AgriBot Environment Configuration
# Copy this file to .env and fill in your IBM Cloud credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM Watsonx.ai ────────────────────────────────────────────────────────────
# ⚠  IBM IAM API keys are LONG RANDOM STRINGS — NOT UUIDs.
# Generate one at: https://cloud.ibm.com/iam/apikeys
# Example format:  AbCdEf1234567890abcdefghijklmnop_ABCDEFGH-1234-ab12
IBM_API_KEY=your-ibm-api-key
IBM_PROJECT_ID=5be2af7f-bd3f-41fd-872c-631cb64abe61

# Find in: Watsonx.ai → your project → Manage tab → General → Project ID


# Sydney region endpoint (au-syd) — keep this unless your project is elsewhere
IBM_WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# Primary model confirmed working on au-syd Lite (tested 2026-07)
# AgriBot auto-falls back if unavailable.
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-a-random-string
FLASK_DEBUG=false

# ── Database (SQLite – no changes needed for local dev) ──────────────────────
DATABASE_URI=sqlite:///agribot.db

# ── RAG Settings ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# ── Default Map Location (India centre) ──────────────────────────────────────
DEFAULT_LATITUDE=20.5937
DEFAULT_LONGITUDE=78.9629

# ── Kisan Sahayak AI assistant ───────────────────────────────────────────────
# Add these to agribot/.env when you receive the provider keys.
# Sarvam is recommended for Indian-language answers and voice services.
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b-conversations

# OpenAI is an optional fallback for text generation.
OPENAI_API_KEY=your-openai-api-key

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Government of India Agmarknet live mandi prices
DATA_GOV_API_KEY=your-data-gov-api-key