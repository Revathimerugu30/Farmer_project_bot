# ─────────────────────────────────────────────────────────────────────────────
# AgriBot Environment Configuration
# Copy this file to .env and fill in your IBM Cloud credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM Watsonx.ai ────────────────────────────────────────────────────────────
# ⚠  IBM IAM API keys are LONG RANDOM STRINGS — NOT UUIDs.
# Generate one at: https://cloud.ibm.com/iam/apikeys
# Example format:  AbCdEf1234567890abcdefghijklmnop_ABCDEFGH-1234-ab12
IBM_API_KEY=IBM_API_KEY

# Find in: Watsonx.ai → your project → Manage tab → General → Project ID
IBM_PROJECT_ID=IBM_PROJECT_ID

# Sydney region endpoint (au-syd) — keep this unless your project is elsewhere
IBM_WATSONX_URL=IBM_URL

# Primary model confirmed working on au-syd Lite (tested 2026-07)
# AgriBot auto-falls back if unavailable.
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=SECRET_KEY
FLASK_DEBUG=false

# ── Database (SQLite – no changes needed for local dev) ──────────────────────
DATABASE_URI=sqlite:///agribot.db

# ── RAG Settings ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# ── Default Map Location (India centre) ──────────────────────────────────────
DEFAULT_LATITUDE=20.5937
DEFAULT_LONGITUDE=78.9629
